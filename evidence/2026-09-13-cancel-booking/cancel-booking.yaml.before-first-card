# Cancel Booking — cancel the account's one Active booking.
#
#   maestro test -e NATIONAL_ID=<10-digit National ID / Iqama> .maestro/cancel-booking.yaml
#
# NATIONAL_ID is the ONLY input, and it is MANDATORY: a run without it, or with a malformed
# value, stops at the first steps below - BEFORE the app is launched.
#
#   Login -> account proven by National ID -> Account -> My bookings -> Active
#     -> the Active booking (its unit code is read from its own card, and the booking is opened
#        BY that code - never by position)
#     -> its invoice number is read from Booking Details: the two together are the booking's
#        identity for the rest of the run
#     -> scroll to "Cancel booking" -> tap it
#     -> "Yes, cancel my booking" -> reason "Unit area" -> "Confirm cancellation"
#     -> the second confirmation, when the product shows one -> "Yes"
#     -> the product's confirmation names the captured unit
#     -> relaunch -> that unit is gone from Active -> it is listed under Cancelled with its
#        cancellation date, and its invoice is re-checked on its details when they show one.
#
# CONTRACT STATUS IS NOT CONSIDERED (14/09/2026, by request). This flow does not read, assert or
# branch on whether the sales contract is Signed or Unsigned, and it never stops because of it.
#
# --- THIS FLOW CANCELS A REAL BOOKING, ON PURPOSE -------------------------------------------
# The product's own dialog says it: "The booking fee is not refunded when you cancel the
# booking". Run it only on a PRE test account whose Active booking may be cancelled.
#
# --- WHICH BOOKING, AND WHEN IT STOPS INSTEAD ------------------------------------------------
# NATIONAL_ID is the only input, so the flow must never GUESS which booking to cancel:
#   no Active booking      -> "No active booking available for cancellation."            STOP
#   two or more Active     -> "Multiple active bookings found. Cancellation is ambiguous." STOP
#   exactly one Active     -> that booking, after its unit code and invoice are captured
# Each stop is logged, screenshotted, and followed by a failing gate assertion - deliberately not
# a pass - with nothing tapped on any cancellation screen.
#
# --- RE-VERIFIED IMMEDIATELY BEFORE "Cancel booking" (the SAFETY GATE) -----------------------
#   1. the signed-in account is NATIONAL_ID (the Nafath screen AND the profile's own field);
#   2. exactly one Active booking was found, and it is the one that was opened;
#   3. the captured unit code was read from that booking's own card;
#   4. the captured invoice number was read from that booking's Booking Details.
#
# --- NEVER ---------------------------------------------------------------------------------
# No reservation, no payment, no payment method, no contract signature, no OTP, no NPS/CSAT
# Submit or rating. No booking card is tapped by position: cards are COUNTED by position, and
# every tap on a card is pinned to its unit code. "Other reason" is never selected (it requires
# free text). On the success screen neither "View booking" nor "Reserve unit" is tapped - the
# flow relaunches. No overlay helper runs between the "Cancel booking" tap and the product's
# confirmation, so a real product error in that window is never cleared away.
#
# The cancellation screens and texts are the ones proven by subflows/ensure-no-active-booking.yaml
# (09/09/2026) and by this flow (13/09/2026, run cancel3-152245: unit 01-01-0504-999-205).
appId: fi.iwa.sakani
name: Cancel booking - the account's single Active booking
env:
  # Same self-referencing form as full-journey.yaml: a literal here silently BEATS `-e` on
  # Maestro 2.9.0. There is NO default account - unsupplied resolves to "" and the fail-fast
  # guard below stops the run before the app is launched.
  NATIONAL_ID: '${typeof NATIONAL_ID === "undefined" ? "" : String(NATIONAL_ID)}'
---
# ==========================================================================================
# 0. FAIL FAST - NATIONAL_ID, before the app is launched
# ==========================================================================================
- evalScript: ${console.log('CANCEL BOOKING TARGET NATIONAL_ID = [' + NATIONAL_ID + ']')}
- evalScript: ${output.targetNationalId = String(NATIONAL_ID)}
# Dollar-free on purpose (a second "$" inside ${...} makes Maestro 2.9.0 skip the check and pass):
# exactly 10 characters, digits only, first digit 1 (National ID) or 2 (Iqama).
- assertTrue: ${String(NATIONAL_ID).length === 10 && !/[^0-9]/.test(String(NATIONAL_ID)) && (String(NATIONAL_ID).charAt(0) === "1" || String(NATIONAL_ID).charAt(0) === "2")}

# ==========================================================================================
# 1. LOGIN - then prove which account is signed in
# ==========================================================================================
- launchApp:
    clearState: true
- runFlow:
    file: subflows/login.yaml
    env:
      NATIONAL_ID: ${NATIONAL_ID}

# Home -> Account. An account that holds a booking can get the NPS survey on Home, and on Home
# it re-opens by itself about 10 s after every close (evidence/2026-09-13-nps-close), so this
# is full-journey.yaml's LEAVE HOME block: clear the rest, close the survey with its X, and tap
# Account at once. Bounded at 5 rounds; Submit and ratings are never tapped.
- repeat:
    times: 5
    while:
      notVisible: "My bookings"
    commands:
      - evalScript: ${output.anchorOptional = true}
      - evalScript: ${output.npsLeftToCaller = true}
      - runFlow:
          file: subflows/clear-overlays.yaml
          env:
            ANCHOR: '(?s)(Account\s*Tab 4 of 4|.*would you recommend benefiting from Sakani.*)'
      - evalScript: ${output.anchorOptional = false}
      - evalScript: ${output.npsLeftToCaller = false}
      - runFlow:
          when:
            visible: "(?s).*would you recommend benefiting from Sakani.*"
          commands:
            - runFlow:
                when:
                  notVisible: '(?s)(.*There.s something wrong.*|.*the service is down.*|Error!)'
                commands:
                  - runFlow:
                      when:
                        visible: "Submit"
                      commands:
                        - evalScript: "${console.log('LEAVE HOME (after login) - NPS up, closing it with its X, then Account at once')}"
                        - tapOn:
                            point: "73,1434"
                            retryTapIfNoChange: false
      - tapOn:
          text: 'Account\s*Tab 4 of 4'
          optional: true
- extendedWaitUntil:
    visible: "My bookings"
    timeout: 60000

# WHO IS SIGNED IN - from the profile's own "National ID" field (records output.profileNationalId
# only after it matched). All three records must agree; a mismatch fails the run right here.
- runFlow:
    file: subflows/verify-signed-in-account.yaml
    env:
      NATIONAL_ID: ${NATIONAL_ID}
- assertTrue: ${output.loginNationalId === output.targetNationalId && output.targetNationalId === String(NATIONAL_ID) && output.profileNationalId === output.targetNationalId}
- evalScript: ${output.identityOk = output.loginNationalId === String(NATIONAL_ID) && output.profileNationalId === String(NATIONAL_ID)}

# ==========================================================================================
# 2. NAVIGATION - Account -> My bookings -> Active
# ==========================================================================================
- runFlow:
    file: subflows/clear-overlays.yaml
    env:
      ANCHOR: "My bookings"
- tapOn: "My bookings"
- extendedWaitUntil:
    visible: "My Bookings"
    timeout: 45000
- assertVisible: 'Active\s*Tab 2 of 4'
- assertVisible: 'Cancelled\s*Tab 4 of 4'
- tapOn: 'Active\s*Tab 2 of 4'
# The tabs paint before the list arrives: wait for a card OR the empty state, never a bare screen.
- extendedWaitUntil:
    visible: "(?s).*(\nActive\n.*Unit code|don.t have any active booking).*"
    timeout: 60000
- takeScreenshot: cancel-00-active-tab-before

# ==========================================================================================
# 3. THE TARGET BOOKING - the single Active one, identified by its own unit code
# ==========================================================================================
# Cards are only COUNTED by position (index 0 and 1 of the Active-card selector). The unit code
# is copied from the card itself, and the booking is then opened BY that code.
- evalScript: ${output.unitCode = ""}
- evalScript: ${output.invoiceNumber = ""}
- evalScript: ${output.activeCardFound = false}
- evalScript: ${output.multipleActive = false}

# A second Active card means the target would be a guess.
- runFlow:
    when:
      visible:
        text: "(?s).*\nActive\n.*\nUnit code\n.*"
        index: 1
    commands:
      - evalScript: ${output.multipleActive = true}

- runFlow:
    when:
      true: ${output.multipleActive !== true}
    commands:
      - runFlow:
          when:
            visible:
              text: "(?s).*\nActive\n.*\nUnit code\n.*"
              index: 0
          commands:
            - evalScript: ${output.activeCardFound = true}
            - copyTextFrom:
                text: "(?s).*\nActive\n.*\nUnit code\n.*"
                index: 0
            - evalScript: '${output.unitCode = (String(maestro.copiedText).match(/Unit code\s*([0-9]{2}(-[0-9]+)+)/) || ["", ""])[1]}'
            - evalScript: "${console.log('CANCEL BOOKING - the Active booking is unit [' + output.unitCode + ']')}"

# Open it - by its unit code - and read its invoice number, then scroll to "Cancel booking".
# (subflows/open-active-booking.yaml leaves the booking on screen at its bottom.)
- runFlow:
    when:
      true: ${output.multipleActive !== true && output.activeCardFound === true && /^[0-9]{2}-[0-9]/.test(output.unitCode)}
    commands:
      - runFlow:
          file: subflows/open-active-booking.yaml
          env:
            UNIT_CODE: ${output.unitCode}
      - evalScript: ${output.invoiceNumber = output.openInvoice}

# ==========================================================================================
# 4. THE SAFETY GATE - the right account, one Active booking, and its identity captured
# ==========================================================================================
- evalScript: ${output.cancelAllowed = output.identityOk === true && output.multipleActive !== true && output.activeCardFound === true && output.openFound === true && /^[0-9]{2}-[0-9]/.test(output.unitCode) && /^[0-9]{10,}/.test(output.invoiceNumber)}
- evalScript: "${console.log('CANCEL BOOKING DECISION - account=' + output.identityOk + ' | one Active booking=' + output.activeCardFound + ' (multiple=' + output.multipleActive + ') | opened=' + output.openFound + ' | unit [' + output.unitCode + '] | invoice [' + output.invoiceNumber + '] | cancelAllowed=' + output.cancelAllowed)}"
- runFlow:
    when:
      true: ${output.cancelAllowed !== true && output.multipleActive === true}
    commands:
      - evalScript: "${console.log('Multiple active bookings found. Cancellation is ambiguous.')}"
- runFlow:
    when:
      true: ${output.cancelAllowed !== true && output.multipleActive !== true && output.activeCardFound !== true}
    commands:
      - evalScript: "${console.log('No active booking available for cancellation.')}"
- runFlow:
    when:
      true: ${output.cancelAllowed !== true && output.multipleActive !== true && output.activeCardFound === true}
    commands:
      - evalScript: "${console.log('The Active booking could not be opened or identified (unit code / invoice number). Nothing cancelled.')}"
- runFlow:
    when:
      true: ${output.cancelAllowed !== true}
    commands:
      - takeScreenshot: cancel-STOP-not-cancellable

# Nothing below this line runs unless the gate above passed: the run stops HERE (a failed
# assertion, deliberately not a pass), with the reason in the log line above, nothing tapped.
- assertTrue: ${output.cancelAllowed === true}

# ==========================================================================================
# 5. CANCEL - through the product's own screens
# ==========================================================================================
- evalScript: "${console.log('CANCEL BOOKING - cancelling unit [' + output.unitCode + '] invoice [' + output.invoiceNumber + ']')}"
- assertVisible: "Cancel booking"
- takeScreenshot: cancel-02-before-cancel
- tapOn: "Cancel booking"

# First confirmation - asserted on its own wording. "No, return project" is the safe branch and
# is only asserted, never tapped.
- extendedWaitUntil:
    visible: "(?s).*booking fee is not refunded.*are you sure you want to cancel.*"
    timeout: 30000
- assertVisible: "No, return project"
- takeScreenshot: cancel-03-first-confirmation
- tapOn: "Yes, cancel my booking"

# Reason. "Unit area" is selected: it needs no free text, unlike "Other reason", which is never
# selected. The eight listed on this build are Project location, Project unit design, Unit price,
# Unit area, Relocation, Reject by bank, Unsigned contract, Other reason. Should "Unit area" ever
# be missing, "Relocation" - also text-free - is used; with neither, the assertion below stops the
# run with the booking still intact.
- extendedWaitUntil:
    visible: "Reason for cancelling"
    timeout: 45000
- takeScreenshot: cancel-04-reason-screen
- evalScript: ${output.reason = ""}
- runFlow:
    when:
      visible: "Unit area"
    commands:
      - tapOn: "Unit area"
      - evalScript: ${output.reason = "Unit area"}
- runFlow:
    when:
      true: ${output.reason === ""}
    commands:
      - runFlow:
          when:
            visible: "Relocation"
          commands:
            - tapOn: "Relocation"
            - evalScript: ${output.reason = "Relocation"}
- assertTrue: ${output.reason === "Unit area" || output.reason === "Relocation"}
- evalScript: "${console.log('CANCEL BOOKING - reason selected [' + output.reason + ']')}"
- waitForAnimationToEnd:
    timeout: 6000
- takeScreenshot: cancel-05-reason-selected

# "Confirm cancellation" stays disabled until a reason is selected.
- tapOn: "Confirm cancellation"

# The SECOND confirmation, when the product shows one - plain "Yes" / "No", matched on their own
# text and on the dialog's own wording. It is handled only if it actually appears.
- waitForAnimationToEnd:
    timeout: 8000
- runFlow:
    when:
      visible: "(?s).*booking fee is not refunded.*"
    commands:
      - assertVisible: "No"
      - takeScreenshot: cancel-06-second-confirmation
      - tapOn: "Yes"

# The product's confirmation names the unit it cancelled - it must be the captured unit.
- extendedWaitUntil:
    visible: "(?s).*has been cancelled successfully.*"
    timeout: 60000
- assertVisible: "Cancellation request submitted"
- assertVisible: "(?s).*${output.unitCode}.*has been cancelled successfully.*"
- takeScreenshot: cancel-07-cancellation-confirmed

# ==========================================================================================
# 6. FINAL VALIDATION - with the unit code and invoice captured BEFORE the cancellation
# ==========================================================================================
# Neither "View booking" nor "Reserve unit" on the success screen is tapped; a relaunch also
# makes My Bookings re-read from the server instead of showing this session's cached list.
- launchApp
- repeat:
    times: 5
    while:
      notVisible: "My bookings"
    commands:
      - evalScript: ${output.anchorOptional = true}
      - evalScript: ${output.npsLeftToCaller = true}
      - runFlow:
          file: subflows/clear-overlays.yaml
          env:
            ANCHOR: '(?s)(Account\s*Tab 4 of 4|.*would you recommend benefiting from Sakani.*)'
      - evalScript: ${output.anchorOptional = false}
      - evalScript: ${output.npsLeftToCaller = false}
      - runFlow:
          when:
            visible: "(?s).*would you recommend benefiting from Sakani.*"
          commands:
            - runFlow:
                when:
                  notVisible: '(?s)(.*There.s something wrong.*|.*the service is down.*|Error!)'
                commands:
                  - runFlow:
                      when:
                        visible: "Submit"
                      commands:
                        - evalScript: "${console.log('LEAVE HOME (after cancellation) - NPS up, closing it with its X, then Account at once')}"
                        - tapOn:
                            point: "73,1434"
                            retryTapIfNoChange: false
      - tapOn:
          text: 'Account\s*Tab 4 of 4'
          optional: true
- runFlow:
    file: subflows/clear-overlays.yaml
    env:
      ANCHOR: "My bookings"
- tapOn: "My bookings"
- extendedWaitUntil:
    visible: "My Bookings"
    timeout: 45000

# The same unit is no longer Active.
- tapOn: 'Active\s*Tab 2 of 4'
- extendedWaitUntil:
    visible: "(?s).*(\nActive\n.*Unit code|don.t have any active booking).*"
    timeout: 60000
- assertNotVisible: "(?s).*\nUnit code\n${output.unitCode}\n.*"
- takeScreenshot: cancel-08-active-tab-after

# ... it is listed as Cancelled, by the same unit code, with its cancellation date.
- tapOn: 'Cancelled\s*Tab 4 of 4'
- extendedWaitUntil:
    visible: "(?s).*Cancellation date.*"
    timeout: 45000
- scrollUntilVisible:
    element:
      text: "(?s).*\nCancelled\n.*\nUnit code\n${output.unitCode}\n.*"
    direction: DOWN
    timeout: 30000
- assertVisible: "(?s).*\nCancelled\n.*\nUnit code\n${output.unitCode}\n.*Cancellation date.*"
- copyTextFrom:
    text: "(?s).*\nCancelled\n.*\nUnit code\n${output.unitCode}\n.*"
- evalScript: '${output.cancellationDate = (String(maestro.copiedText).match(/Cancellation date\s*([0-9]{2}\/[0-9]{2}\/[0-9]{4})/) || ["", ""])[1]}'
- takeScreenshot: cancel-09-cancelled-tab-after

# ... and, when the cancelled booking's details show an invoice number, it is the captured one.
# (Opening a cancelled booking is read-only; if its details do not show an invoice, that is
# recorded rather than guessed.)
- evalScript: ${output.cancelledInvoiceChecked = false}
- tapOn: "(?s).*\nCancelled\n.*\nUnit code\n${output.unitCode}\n.*"
- runFlow:
    when:
      visible: 'Booking Details\s*Tab 1 of 2'
    commands:
      - scrollUntilVisible:
          element:
            text: "Invoice number"
          direction: DOWN
          timeout: 20000
          optional: true
      - runFlow:
          when:
            visible: "Invoice number"
          commands:
            - assertVisible:
                text: "${output.invoiceNumber}"
                below:
                  text: "Invoice number"
            - evalScript: ${output.cancelledInvoiceChecked = true}
      - takeScreenshot: cancel-10-cancelled-booking-details
- evalScript: "${console.log('CANCEL BOOKING END - unit [' + output.unitCode + '] invoice [' + output.invoiceNumber + '] cancelled - gone from Active, listed as Cancelled on [' + output.cancellationDate + '] - invoice re-checked on the cancelled booking=' + output.cancelledInvoiceChecked + ' - reason [' + output.reason + ']')}"
