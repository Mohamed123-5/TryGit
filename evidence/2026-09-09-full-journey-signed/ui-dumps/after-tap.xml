e-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="33,231,264.4" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1561][289,1632]" /><node index="6" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="m²" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[300,1569][345,1624]" /><node index="7" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc='تعد "خزام" إحدى أكبر الوجهات السكنية التي تطورها NHC، في شمال مدينة الرياض بمكان حيوي بالقرب من أهم المعالم كمطار الملك خالد الدولي، وموقع الرياض اكسبو ٢٠٣٠، وحديقة الملك عبد العزيز، وكذلك استاد الملك سلمان. وتمتد " خزام " على مساحة إجمالية تقدر بنحو 30 مليون م٢، لتوفر أكثر من 50 ألف وحدة سكنية تتسع لأكثر من 281 ألف نسمة، ويمتد في قلب الوجهة من شمالها الى جنوبها حديقة خزام الكبرى بمساحة 4.5 مليون متر م٢، بشكل طولي لتغطي كافة أرجاء الضاحية مراعية متطلبات جودة الحياة، وأبرز معالم NHC مثل مركز خزام للأعمال، وبوليفارد خزام، وخزام مول، بالإضافة إلى المدارس العالمية والمراكز تجارية وخدمات الضيافة الفندقية والترفيهية، لتوفر لسكانها كافة احتياجاتهم.' checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1664][1038,2001]" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="Register interest" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,2022][1038,2148]" /><node index="2" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani