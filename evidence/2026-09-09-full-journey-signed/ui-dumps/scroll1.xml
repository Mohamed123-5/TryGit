عمال، وبوليفارد خزام، وخزام مول، بالإضافة إلى المدارس العالمية والمراكز تجارية وخدمات الضيافة الفندقية والترفيهية، لتوفر لسكانها كافة احتياجاتهم.' checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,464][1038,1283]" /><node index="7" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="Location" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1398][197,1461]" /><node index="8" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="Shaqra, Riyadh Region" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1461][442,1524]" /><node index="9" text="" resource-id="" class="android.view.View" package="fi.iwa.sakani" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1545][1038,2001]"><node index="0" text="" resource-id="" class="android.widget.ImageView" package="fi.iwa.sakani" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1545][1038,2001]"><node index="0" text="" resource-id="" class="android.widget.FrameLayout" package="fi.iwa.sakani" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1545][1037,2059]"><node index="0" text="" resource-id="" class