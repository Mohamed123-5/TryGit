# MKT-001 — Explore loads the marketplace.
#
# Scope: MKT-001 only. Per the automation triage in exploration-report.md this case
# absorbs MKT-005 (result count displayed), so the flow asserts that Explore rendered
# actual marketplace content - a result count, the Projects/units sub-tabs and at
# least one listing - not merely that the Explore tab is selectable.
#
# Precondition is "Any": MKT-001 does not require authentication, so this flow does not
# depend on login.yaml and does not clear state.
appId: fi.iwa.sakani
name: MKT-001 Explore loads marketplace
---
- launchApp

# The satisfaction survey reappears on every launch (defect D-12) and covers the tab
# bar; the staging dashboard error dialog is intermittent. Clear only what blocks us.
- waitForAnimationToEnd:
    timeout: 20000
- repeat:
    times: 6
    commands:
      # Onboarding, which this flow can meet on its own: the app is launched WITHOUT clearState,
      # so it starts from whatever the device holds - including a cleared state left by another
      # flow's clearState launch, or a fresh install. Without this handler the run would wait for
      # the tab bar behind the onboarding carousel and time out. Same handler project.yaml has
      # (added 14/09/2026 so this test runs standalone, in any order).
      - runFlow:
          when:
            visible: "Skip"
          commands:
            - tapOn: "Skip"
      - runFlow:
          when:
            visible: "Dismiss"
          commands:
            - tapOn: "Dismiss"
      - runFlow:
          when:
            visible: "Ok"
          commands:
            - tapOn: "Ok"
      # Build STG-4.7.5-1278 adds a "Marketplace Day" countdown sheet with a full scrim that
      # lands before the compare coach mark and removes Home from the hierarchy while it is
      # up. Back dismisses it. Harmless on PRE-4.7.5-1279, where the sheet never appears.
      - runFlow:
          when:
            visible: "Marketplace Day"
          commands:
            - back
      - waitForAnimationToEnd:
          timeout: 5000

- extendedWaitUntil:
    visible: 'Explore\s*Tab 2 of 4'
    timeout: 30000
- tapOn: 'Explore\s*Tab 2 of 4'

# Build STG-4.7.5-1278 lands Explore on a map-first view and gates the marketplace list
# behind a "Select category" sheet: the Projects/Units sub-tabs and the result count only
# exist once a category has been chosen and "Start searching" tapped. STG is the
# authoritative baseline, so the gate is completed rather than worked around - the case
# still proves the same thing, that Explore renders real marketplace content.
#
# The gate is entered through the construction-status filter chip rather than the
# "Find more Sakani products..." banner. Both open a category sheet, but the banner is only
# rendered while no category has been chosen - once one is, the app persists it and the
# banner is replaced by the category chip, whose own sheet ("Browse Categories") leads back
# to the destinations view rather than to the list. The construction-status chip is present
# in both states, so it is the one entry that works on a cold and a warm Explore alike.
#
# The chip is matched on the set of labels it can carry: "Construction Status" when unset, or
# the applied value once set. "Ready(made| Units)" covers PRE-4.7.5-1279's "Readymade" and
# STG-4.7.5-1278's "Ready Units". Applying a filter is a UI-only operation; it changes no
# account or business state.
#
# The whole section is conditional and exits as soon as the sub-tabs exist, so on PRE - where
# Explore lists the marketplace directly - it falls straight through.
#
# The chip opens one of two sheets depending on whether a category has been chosen before:
# "Select category" (Buy/Rent + construction status, confirmed with "Start searching") on a
# freshly cleared install, or the "Construction Status" filter sheet (confirmed with "Apply")
# once one has. Both are handled so the flow does not depend on leftover state.
# Open the sheet once, confirm whichever variant appeared, then wait for the list. This is
# deliberately linear rather than a poll: a retry loop oscillates, because the search can take
# longer than any per-iteration wait and the next pass simply reopens the sheet it just closed.
- runFlow:
    when:
      notVisible: '[Uu]nits\s*Tab 2 of 2'
    commands:
      - tapOn: "(Construction Status|Ready Units|Readymade|Offplan|Land)"
      - waitForAnimationToEnd:
          timeout: 8000
      - runFlow:
          when:
            visible: "Start searching"
          commands:
            - tapOn: "Buy"
            - tapOn: "Ready(made| Units)"
            - tapOn: "Start searching"
      - runFlow:
          when:
            visible: "Apply"
          commands:
            - tapOn: "Ready(made| Units)"
            - tapOn: "Apply"

- extendedWaitUntil:
    visible: '[Uu]nits\s*Tab 2 of 2'
    timeout: 90000

# The marketplace shell (search bar, category chips) renders immediately even when the
# search itself never resolves, so the shell is not sufficient evidence. Assert the
# content that only appears once the search has actually returned.
#
# MKT-005's result count: PRE renders "N Units for sale", STG "N Units for Sale". The sub-tab
# is "units Tab 2 of 2" on PRE and "Units Tab 2 of 2" on STG. Both are matched so the same
# assertion holds on either build - the intent, that a count and both sub-tabs are present,
# is unchanged.
- extendedWaitUntil:
    visible: "(?s).*Units for [Ss]ale.*"
    timeout: 60000
- assertVisible: 'Projects\s*Tab 1 of 2'
- assertVisible: '[Uu]nits\s*Tab 2 of 2'
