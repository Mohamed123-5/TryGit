appId: fi.iwa.sakani
name: Sakani login with National ID
env:
  # The account this flow signs in as. Default (no override): 1000011487, standardised across
  # the suite on 14/09/2026 (it was 1000011485 before). Override with:
  #   maestro test -e NATIONAL_ID=<10-digit National ID / Iqama> .maestro/login.yaml
  # A self-referencing default, NOT a literal: on Maestro 2.9.0 a literal here silently beats
  # `-e NATIONAL_ID=...`. Single-quoted because the expression contains ": ".
  NATIONAL_ID: '${typeof NATIONAL_ID === "undefined" ? "1000011487" : String(NATIONAL_ID)}'
---
# Fail fast, before the app is touched, on an empty or malformed override. Dollar-free on
# purpose: a "$" inside ${...} makes Maestro 2.9.0 skip evaluation and pass the assert.
- evalScript: ${console.log('LOGIN.YAML TARGET NATIONAL_ID = [' + NATIONAL_ID + ']')}
- assertTrue: ${String(NATIONAL_ID).length === 10 && !/[^0-9]/.test(String(NATIONAL_ID)) && (String(NATIONAL_ID).charAt(0) === "1" || String(NATIONAL_ID).charAt(0) === "2")}
- launchApp:
    clearState: true

# A cold start after a state wipe on this build can take well over a minute to paint its
# first frame - the process is alive throughout, logcat shows no crash, the UI simply has
# not rendered yet - so the onboarding carousel is waited for generously rather than on a
# 30s budget that can expire against a still-blank screen. Same tolerance the other
# cleared-launch flows already use.
# Clear the first-run surfaces until the compare coach mark is up.
#
# Two build-specific hazards are handled here. A cold start after a state wipe can take well
# over a minute to paint its first frame - the process is alive throughout and logcat shows no
# crash, the UI simply has not rendered yet. And STG-4.7.5-1278 interposes a "Marketplace Day"
# countdown sheet between the onboarding carousel and the coach mark, whose scrim removes
# everything underneath from the hierarchy; Back dismisses it.
#
# The Marketplace Day branch is deliberately the ONLY thing that presses Back here. An
# earlier revision also polled "Skip" in this loop; that let Back fire on a pass where the
# sheet had already gone but its node still lingered, which popped the stack and left the run
# on the Android launcher. Waiting for the carousel explicitly and tapping it once keeps the
# Back presses tied strictly to the sheet being present.
- waitForAnimationToEnd:
    timeout: 20000
- extendedWaitUntil:
    visible: "Skip"
    timeout: 120000
- tapOn: "Skip"

- repeat:
    times: 8
    commands:
      - runFlow:
          when:
            visible: "Marketplace Day"
          commands:
            - back
            - waitForAnimationToEnd:
                timeout: 3000
      - runFlow:
          when:
            notVisible: "Start comparing properties"
          commands:
            - waitForAnimationToEnd:
                timeout: 5000

- extendedWaitUntil:
    visible: "Start comparing properties"
    timeout: 30000

# Top-left close icon of the popup is a NAF ImageView in the live hierarchy.
# Bounds: [42,659][105,722] on PRE-4.7.5-1279, re-verified unchanged on STG-4.7.5-1278.
# No text/contentDescription is exposed, so this is the stable close selector available
# for this build. Coordinate deliberately NOT changed - it is still correct.
- tapOn:
    point: "73,690"

- extendedWaitUntil:
    notVisible: "Start comparing properties"
    timeout: 30000

- extendedWaitUntil:
    visible: "(?s).*Login / Sign up.*"
    timeout: 30000
- assertVisible: "(?s).*Login / Sign up.*"
- tapOn: "(?s).*Login / Sign up.*"

# Build PRE-4.7.5-1279 spells this "Nefath"; the STG build spelled it "Nafath"
# (defect D-14). Match what this build actually renders.
- extendedWaitUntil:
    visible: "Continue with N[ae]fath"
    timeout: 30000

# --- AUTH-002: Continue must not proceed on empty, too-short or non-numeric input.
# The button reports enabled="true" even when it is visually disabled - only
# "clickable" flips - so Maestro cannot assert the attribute. Assert the behaviour
# instead: tapping Continue must not reach the Nafath screen.
- tapOn: "Continue"
- waitForAnimationToEnd:
    timeout: 3000
- assertNotVisible: "Login with nafath"

- tapOn: "Enter your ID, phone number,? or email"
- inputText: "123"
- tapOn: "Continue"
- waitForAnimationToEnd:
    timeout: 3000
- assertNotVisible: "Login with nafath"

- tapOn: "123"
- eraseText
- inputText: "abcdefghij"
- tapOn: "Continue"
- waitForAnimationToEnd:
    timeout: 3000
- assertNotVisible: "Login with nafath"

- tapOn: "abcdefghij"
- eraseText
# --- end AUTH-002

# --- AUTH-012: the alternate "Continue with N[ae]fath" entry opens the Nafath path.
# Runs from the empty field AUTH-002 leaves behind. Scoped to navigation only: the
# screen is asserted, nothing is submitted, and no external Nafath approval is
# involved - the case is "Nafath path opens", not "Nafath authenticates" (AUTH-006).
# "Confirm" is present but inert here because no ID has been supplied, which is also
# why this cannot accidentally authenticate.
- tapOn: "Continue with N[ae]fath"
- extendedWaitUntil:
    visible: "Login with nafath"
    timeout: 30000
- assertVisible: "Use your nafath information to login"
- assertVisible: "National ID / Iqama number"
- assertVisible: "Confirm"

# Return to the login screen so the happy path below starts from a known state.
# Back from the Nafath screen unwinds the whole login stack to the guest Home rather
# than to the login screen it was opened from, so the login entry has to be re-opened
# instead of assuming a single step back.
- back
- extendedWaitUntil:
    visible: "(?s).*Login / Sign up.*"
    timeout: 30000
- tapOn: "(?s).*Login / Sign up.*"
- extendedWaitUntil:
    visible: "Continue with N[ae]fath"
    timeout: 30000
- assertVisible: "Enter your ID, phone number,? or email"
- assertNotVisible: "Login with nafath"

# Re-focus the ID field. AUTH-002 left it focused; re-opening the login screen above
# does not, and the happy path below types straight into it.
- tapOn: "Enter your ID, phone number,? or email"
# --- end AUTH-012

# The field hint carries a comma before "or" in this build.
- inputText: ${NATIONAL_ID}
- assertVisible: ${NATIONAL_ID}

- tapOn: "Continue"

- extendedWaitUntil:
    visible: "Login with nafath"
    timeout: 30000
- assertVisible: "Confirm"
# The Nafath screen must carry EXACTLY the requested ID before the session is created. Text
# selectors are full-match, so any other ID - including a default that silently won over an
# override - fails here, before authentication.
- assertVisible: ${NATIONAL_ID}
- tapOn: "Confirm"

- extendedWaitUntil:
    notVisible: "Login with nafath"
    timeout: 60000

# A "Sakani Loyalty / Weekly Offer" (renamed "Sakani sharrai / weekly deal" on PRE-4.7.6-1283) promo sheet lands non-deterministically after
# authentication, and while it is up "Maybe Later" leaves the hierarchy entirely.
# A one-shot check here is not enough: if the promo arrives *during* the wait below it
# is never cleared, "Maybe Later" never becomes visible, and the wait exhausts its
# timeout even though authentication succeeded. Poll instead - dismiss the promo on
# every pass until the biometrics prompt has surfaced. The loop exits early once
# "Maybe Later" is visible, so it costs nothing on runs where the promo never appears.
- repeat:
    times: 12
    commands:
      - runFlow:
          when:
            visible: "Go to the weekly (offer|deal)"
          commands:
            - back
            - waitForAnimationToEnd:
                timeout: 3000
      - runFlow:
          when:
            notVisible: "Maybe Later"
          commands:
            - waitForAnimationToEnd:
                timeout: 5000

# AUTH-007 / AUTH-008 (merged into AUTH-006): biometric enrolment is offered after a
# successful login and can be skipped. The label is "Maybe Later" with a capital L.
- extendedWaitUntil:
    visible: "Maybe Later"
    timeout: 60000
- assertVisible: "Enable Biometrics"

# The "Sakani Loyalty / Weekly Offer" (renamed "Sakani sharrai / weekly deal" on PRE-4.7.6-1283) promo sheet can land before the biometrics
# prompt, between asserting it and tapping it, or after it is dismissed - and while
# it is up "Maybe Later" leaves the hierarchy entirely. Poll instead of assuming an
# order: clear whichever overlay is on top until both are gone.
- repeat:
    times: 4
    commands:
      - runFlow:
          when:
            visible: "Go to the weekly (offer|deal)"
          commands:
            - back
            - waitForAnimationToEnd:
                timeout: 3000
      - runFlow:
          when:
            visible: "Maybe Later"
          commands:
            - tapOn: "Maybe Later"
            - waitForAnimationToEnd:
                timeout: 3000

# AUTH-006 / AUTH-010: confirm we are actually authenticated. The guest login entry
# must be gone, and Home must greet the user BY NAME.
#
# Build STG-4.7.5-1278 replaced PRE's time-of-day greeting ("Good Morning, <name>") with
# "Hello, <name>". Both are matched so the same assertion holds on either build. The
# ",\s*\S" tail is the load-bearing part and is deliberately NOT relaxed to a bare
# "Hello": the greeting must be followed by an actual name, which is what distinguishes an
# authenticated header from a guest one - the guest Account renders "Hello" with nothing
# after it. Home also shows "Good Morning, " with an empty tail while the profile is still
# loading, so requiring a non-space character guards that race too.
- extendedWaitUntil:
    notVisible: "(?s).*Login / Sign up.*"
    timeout: 60000
- assertVisible: '(?si)(Hello|Good (morning|afternoon|evening)),\s*\S.*'

# The popup's top-left Close affordance is an unlabelled NAF ImageView in the
# current PREPROD hierarchy. The stable selector available in the live UI is the
# popup's visible CTA text "Start comparing properties", which dismisses the
# overlay before the login button is asserted and tapped.

# --- AUTH-009: the session must survive an app restart.
# launchApp without clearState stops and relaunches the app, which is the
# force-stop-and-relaunch this case calls for. Silent session loss here would be a
# severe regression, so the check runs immediately after a known-good login.
- launchApp
- waitForAnimationToEnd:
    timeout: 20000

# The satisfaction survey reappears on every launch (defect D-12); the staging
# dashboard error dialog is intermittent; and STG-4.7.5-1278 raises its "Marketplace Day"
# sheet on this relaunch too, whose scrim removes the tab bar from the hierarchy entirely.
# Poll until the tab bar has surfaced rather than spending a fixed budget, clearing
# whichever overlay is on top. The loop exits as soon as the tab bar appears.
- repeat:
    times: 10
    commands:
      - runFlow:
          when:
            visible: "Dismiss"
          commands:
            - tapOn: "Dismiss"
      - runFlow:
          when:
            visible: "Ok"
          commands:
            - tapOn: "Ok"
      - runFlow:
          when:
            visible: "Marketplace Day"
          commands:
            - back
      - runFlow:
          when:
            visible: "Start comparing properties"
          commands:
            - back
      - runFlow:
          when:
            notVisible: 'Account\s*Tab 4 of 4'
          commands:
            - waitForAnimationToEnd:
                timeout: 5000

- extendedWaitUntil:
    visible: 'Account\s*Tab 4 of 4'
    timeout: 60000
- assertNotVisible: "(?s).*Login / Sign up.*"
- assertVisible: '(?si)(Hello|Good (morning|afternoon|evening)),\s*\S.*'
# --- end AUTH-009
